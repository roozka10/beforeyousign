# Required Environment Variables for beforeyousign

# OpenRouter API key. SERVER ONLY: no VITE_ prefix, so it never ships to the browser.
# Vercel: Project → Settings → Environment Variables → OPENROUTER_API_KEY
# Local:  put it in .env.local (gitignored)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Supabase Configuration
# Get from: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Models are set in src/services/ai-lawyer.ts (AI_MODELS):
# nvidia/nemotron-3.5-lightning:free → nemotron-3.5-super-vl:free → gemma-4-26b-a4b-it:free
